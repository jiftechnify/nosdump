{
  "name": "@jiftechnify/nosdump",
  "version": "0.7.1",
  "exports": "./mod.ts",
  "tasks": {
    "static-checks": "deno check --no-lock mod.ts & deno fmt --check & deno lint",
    "publish-check": "deno publish --dry-run",
    "test": "deno test -A --no-lock",
    "tidy": "rm -f deno.lock && deno cache \"*.ts\""
  },
  "imports": {
    "@cliffy/ansi": "jsr:@cliffy/ansi@^1.2.1",
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
    "@cliffy/table": "jsr:@cliffy/table@^1.2.1",
    "@retraigo/duration": "jsr:@retraigo/duration@^7.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/collections": "jsr:@std/collections@^1.3.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/streams": "jsr:@std/streams@^1.1.2",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "date-fns": "npm:date-fns@^4.4.0",
    "env-paths": "npm:env-paths@^3.0.0",
    "nostr-fetch": "npm:nostr-fetch@^0.17.0",
    "nostr-tools/": "npm:/nostr-tools@^2.25.2/",
    "zod": "npm:zod@^4.6.2",
    "zod-validation-error": "npm:zod-validation-error@^5.0.0"
  },
  "publish": {
    "exclude": [
      ".github"
    ]
  },
  "fmt": {
    "lineWidth": 140,
    "exclude": [
      "vendor/"
    ]
  },
  "lint": {
    "exclude": [
      "vendor/"
    ]
  }
}
